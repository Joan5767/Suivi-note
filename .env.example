# Copie ce fichier sous le nom .env.local, puis remplace les valeurs.
# Ne publie et ne partage jamais .env.local.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TON-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TA_CLE_ANON_PUBLIQUE
SUPABASE_SERVICE_ROLE_KEY=TA_CLE_SERVICE_ROLE_PRIVEE

# Adresse publique de l'application
NEXT_PUBLIC_APP_URL=https://TON-APPLICATION.vercel.app

# Notifications push Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=TA_CLE_VAPID_PUBLIQUE
VAPID_PRIVATE_KEY=TA_CLE_VAPID_PRIVEE
PUSH_WORKER_SECRET=UN_SECRET_LONG_ET_ALEATOIRE

# Notifications e-mail (facultatif)
RESEND_API_KEY=TA_CLE_RESEND
NOTIFICATION_FROM=Rappels <onboarding@resend.dev>
NOTIFICATION_EMAIL=ton-adresse@email.fr

# Assistant de saisie rapide (facultatif)
GEMINI_API_KEY=TA_CLE_GEMINI
GEMINI_MODEL=gemini-3.6-flash

# Paramètres généraux
APP_TIMEZONE=Europe/Paris
CRON_SECRET=UN_AUTRE_SECRET_LONG_ET_ALEATOIRE
NEXT_PUBLIC_DEMO_MODE=false
DEMO_MODE=false
